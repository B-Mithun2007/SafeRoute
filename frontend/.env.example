# SafeRoute-AI Frontend Environment Variables
# Copy to .env in frontend/ directory

# Backend API Base URL
# For Android Emulator use: http://10.0.2.2:8000
# For iOS Simulator / Web use: http://localhost:8000
# For physical phone on same Wi-Fi: http://<your-lan-ip>:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional Mapbox Access Token (if using Mapbox)
EXPO_PUBLIC_MAPBOX_TOKEN=

# Force Mock API Mode (true/false) - defaults to auto (falls back to mock if backend is unreachable)
EXPO_PUBLIC_USE_MOCK_API=false
