# SafeRoute-AI Frontend Environment Variables
# Copy to .env in frontend/ directory
# Windows: copy .env.example .env
# macOS/Linux: cp .env.example .env

# ==============================================================================
# API Base URL
# ==============================================================================
# Leave commented to use automatic platform detection:
#   - Android Emulator → http://10.0.2.2:8000  (auto-detected)
#   - iOS Simulator    → http://localhost:8000  (auto-detected)
#   - Expo Web         → http://localhost:8000  (auto-detected)
#
# Uncomment and set your PC's LAN IP for physical device testing:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000
#
# To find your LAN IP on Windows: run `ipconfig` and look for IPv4 Address
# under your Wi-Fi adapter. Then start FastAPI with:
# uvicorn app.main:app --reload --host 0.0.0.0 --port 8000

# ==============================================================================
# Mock API Mode
# ==============================================================================
# EXPO_PUBLIC_USE_MOCK_API=true   → Always use sample data (demo mode)
# EXPO_PUBLIC_USE_MOCK_API=false  → Real API mode (default for integration testing)
EXPO_PUBLIC_USE_MOCK_API=false

# EXPO_PUBLIC_AUTO_FALLBACK=true  → Silently fall back to mock data on API error
# EXPO_PUBLIC_AUTO_FALLBACK=false → Show real errors in console (integration testing)
EXPO_PUBLIC_AUTO_FALLBACK=false
