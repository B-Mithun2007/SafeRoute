# ==========================================
# SafeRoute-AI Root .gitignore
# ==========================================

# Environment variables & local secrets
.env
.env.*
!.env.example

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node.js / React Native / Expo
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Expo artifacts
.expo/
.expo-shared/
web-build/
*.tsbuildinfo

# Native build artifacts (if ejected or prebuilt)
frontend/android/
frontend/ios/

# Machine Learning datasets & serialized models
ml/dataset/*
!ml/dataset/.gitkeep
!ml/dataset/README.md
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.pt
ml/models/*.onnx
*.h5
*.tflite

# Logs & temporary files
*.log
logs/
tmp/
scratch/
