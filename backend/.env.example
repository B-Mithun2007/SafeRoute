# ==============================================================================
# SafeRoute-AI Backend – Environment Configuration Template
# ==============================================================================
# HOW TO USE:
#   1. Copy this file:  copy .env.example .env   (Windows)
#                  or:  cp .env.example .env     (macOS/Linux)
#   2. Fill in your local values in the .env file.
#   3. NEVER commit the real .env file to version control.
#      It is listed in .gitignore — keep it there.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_TITLE=SafeRoute AI Backend
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production
DEBUG=True                       # Set to False in production

# ------------------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Comma-separated list of allowed CORS origins (no spaces)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Physical device CORS origins (comma-separated LAN IPs of test devices)
# Example: CORS_EXTRA_ORIGINS=http://192.168.1.100:8000,http://192.168.1.101:8000
# Leave empty for local emulator/simulator development
CORS_EXTRA_ORIGINS=

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a secure random string (minimum 32 characters) for production.
JWT_SECRET_KEY=saferoute-ai-development-secret-key-change-in-production-32chars

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# For local development, SQLite is used automatically (persisted to backend/saferoute.db).
# To override with PostgreSQL/PostGIS in future phases:
# DATABASE_URL=postgresql+psycopg://your_db_user:your_db_password@localhost:5432/saferoute_db
DATABASE_URL=sqlite:///./saferoute.db

# Optional: Set to True to log all SQL queries to the console (useful for debugging)
DB_ECHO=False

# ------------------------------------------------------------------------------
# Alembic Migration Settings  (Future database migration phase)
# ------------------------------------------------------------------------------
# ALEMBIC_DATABASE_URL=postgresql+psycopg://migration_user:password@localhost:5432/saferoute_db

# ------------------------------------------------------------------------------
# OSRM Routing Service  (OpenStreetMap-based routing engine)
# ------------------------------------------------------------------------------
OSRM_BASE_URL=http://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# Generative AI — Google Gemini API
# ------------------------------------------------------------------------------
# NEVER expose this key in frontend code or commit it to version control.
# All Gemini API calls must be made exclusively through the Python backend.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Machine Learning Settings  (Future ML phase)
# ------------------------------------------------------------------------------
ML_MODEL_PATH=ml/models/safety_model.joblib
ML_CONFIDENCE_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# Mobile Client (Expo / React Native)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
