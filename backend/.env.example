# ==============================================================================
# SafeRoute-AI Backend — Environment Configuration Template
# ==============================================================================
# HOW TO USE:
#   1. Copy this file:  copy .env.example .env   (Windows)
#                  or:  cp .env.example .env     (macOS/Linux)
#   2. Fill in your local values in the .env file.
#   3. NEVER commit the real .env file to version control.
#      It is listed in .gitignore — keep it there.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_TITLE=SafeRoute AI Backend
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production
DEBUG=True                       # Set to False in production

# ------------------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Physical device CORS origins (comma-separated LAN IPs of test devices)
# Example: CORS_EXTRA_ORIGINS=http://192.168.1.100:8000
CORS_EXTRA_ORIGINS=

# ------------------------------------------------------------------------------
# PostgreSQL + PostGIS Database
# ------------------------------------------------------------------------------
# Primary database connection string using the psycopg 3 driver.
# Replace <YOUR_POSTGRES_PASSWORD> with your actual postgres user password.
# The database 'saferoute_db' must exist and have PostGIS installed:
#   CREATE DATABASE saferoute_db;
#   \c saferoute_db
#   CREATE EXTENSION IF NOT EXISTS postgis;
DATABASE_URL=postgresql+psycopg://postgres:<YOUR_POSTGRES_PASSWORD>@localhost:5432/saferoute_db

# Optional: Set to True to log all SQL queries to the console
DB_ECHO=False

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a secure random string (minimum 32 characters) for production.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secure-jwt-secret-key-minimum-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ------------------------------------------------------------------------------
# OSRM Routing Service  (OpenStreetMap-based routing engine)
# ------------------------------------------------------------------------------
OSRM_BASE_URL=http://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# Generative AI — Google Gemini API
# ------------------------------------------------------------------------------
# NEVER expose this key in frontend code or commit it to version control.
# All Gemini API calls must be made exclusively through the Python backend.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Machine Learning Settings  (Future ML phase)
# ------------------------------------------------------------------------------
ML_MODEL_PATH=ml/models/safety_model.joblib
ML_CONFIDENCE_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# Mobile Client (Expo / React Native)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
