# ==============================================================================
# SafeRoute-AI Backend – Environment Configuration Template
# ==============================================================================
# HOW TO USE:
#   1. Copy this file:  copy .env.example .env   (Windows)
#                  or:  cp .env.example .env     (macOS/Linux)
#   2. Fill in your local values in the .env file.
#   3. NEVER commit the real .env file to version control.
#      It is listed in .gitignore — keep it there.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_TITLE=SafeRoute AI Backend
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production
DEBUG=True                       # Set to False in production

# ------------------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Comma-separated list of allowed CORS origins (no spaces)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# ------------------------------------------------------------------------------
# Database Configuration  (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
#
# IMPORTANT: Use the postgresql+psycopg:// scheme (psycopg3 / modern driver).
#            Do NOT use postgresql:// or postgresql+psycopg2://.
#
# Replace placeholder values with your local PostgreSQL credentials.
# DO NOT hardcode real passwords here — this is only an example template.
DATABASE_URL=postgresql+psycopg://your_db_user:your_db_password@localhost:5432/saferoute_db

# Optional: Set to True to log all SQL queries to the console (useful for debugging)
DB_ECHO=False

# PostGIS is an extension on the PostgreSQL database — no separate URL needed.
# Ensure PostGIS is installed and activated on your DB:
#   CREATE EXTENSION IF NOT EXISTS postgis;

# ------------------------------------------------------------------------------
# Alembic Migration Settings  (Phase 2 — database integration)
# ------------------------------------------------------------------------------
# Alembic reads DATABASE_URL above. No separate variable needed unless you
# prefer a distinct migration-only user with limited privileges.
# ALEMBIC_DATABASE_URL=postgresql+psycopg://migration_user:password@localhost:5432/saferoute_db

# ------------------------------------------------------------------------------
# OSRM Routing Service  (OpenStreetMap-based routing engine)
# ------------------------------------------------------------------------------
# Local self-hosted OSRM instance (recommended for production/offline hackathon).
# Fall back to the public demo server for quick prototyping only.
OSRM_BASE_URL=http://router.project-osrm.org
# OSRM_BASE_URL=http://localhost:5000     # Uncomment for a local OSRM instance
OSRM_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# Generative AI — Google Gemini API
# ------------------------------------------------------------------------------
# NEVER expose this key in frontend code or commit it to version control.
# All Gemini API calls must be made exclusively through the Python backend.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash    # Model identifier (e.g. gemini-2.0-flash, gemini-1.5-pro)

# ------------------------------------------------------------------------------
# Machine Learning Settings  (Phase 3 — ML integration)
# ------------------------------------------------------------------------------
# Path to the trained CART Decision Tree model artifact (relative to project root)
ML_MODEL_PATH=ml/models/safety_model.joblib

# Minimum prediction confidence (0.0–1.0) required before trusting ML output
ML_CONFIDENCE_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# Mobile Client (Expo / React Native)
# ------------------------------------------------------------------------------
# This variable is read by the Expo frontend to know where the backend lives.
# Update this to your machine's local network IP when testing on a physical device.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
