# ==============================================================================
# SafeRoute-AI Environment Configuration Template (.env.example)
# Duplicate this file as '.env' and fill in local development values.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Database Configuration (PostgreSQL / PostGIS)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/saferoute_db
DB_ECHO=False

# Machine Learning Service Settings
ML_MODEL_PATH=ml/models/safety_model.joblib
ML_CONFIDENCE_THRESHOLD=0.65

# External Mapping & Routing API Keys (Optional / Hackathon Stubs)
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Mobile App (Expo) Public Variables
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
